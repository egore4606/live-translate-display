[Unit]
Description=Live Translate Gemini WebSocket relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=live-translate
Group=live-translate
WorkingDirectory=/opt/live-translate-proxy
ExecStart=/usr/bin/node /opt/live-translate-proxy/src/proxy.js
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3015
Environment=ALLOWED_ORIGIN=https://translate.example
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryMax=128M

[Install]
WantedBy=multi-user.target
